// Add this near the top of android/app/build.gradle (or build.gradle.kts —
// see the Kotlin DSL version below), BEFORE the `android { ... }` block.
// It reads MAPS_API_ANDROID from the project's .env file so the real key
// never has to be duplicated or hardcoded inside the Android project.

def envFile = rootProject.file("../.env")
def envVars = [:]
if (envFile.exists()) {
    envFile.eachLine { line ->
        if (line.trim() && !line.trim().startsWith('#') && line.contains('=')) {
            def (key, value) = line.split('=', 2)
            envVars[key.trim()] = value.trim()
        }
    }
}

android {
    // ...existing config...

    defaultConfig {
        // ...existing applicationId, minSdk, etc...

        manifestPlaceholders += [
            MAPS_API_KEY: envVars.get('MAPS_API_ANDROID', '')
        ]
    }
}

