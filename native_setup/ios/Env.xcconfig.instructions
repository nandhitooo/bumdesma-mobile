// ios/Flutter/Env.xcconfig
//
// Xcconfig files use the same `KEY = VALUE` syntax as .env files, so we can
// pull the Maps key straight from the project's .env without duplicating it.
// Create this file at ios/Flutter/Env.xcconfig with the following content:

#include "../../.env"

// Then, in BOTH ios/Flutter/Debug.xcconfig and ios/Flutter/Release.xcconfig
// (created by `flutter create .`), add this line at the very top,
// before the existing #include "Generated.xcconfig":
//
//   #include "Env.xcconfig"
//
// NOTE: .env uses MAPS_API_IOS=... (no quotes), which is valid xcconfig
// syntax as-is, so no reformatting is needed.
