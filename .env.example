MAPS_API_ANDROID=your-android-maps-api-key
MAPS_API_IOS=your-ios-maps-api-key
# Base URL backend TANPA akhiran /api — ApiClient yang menambahkan /api.
# (ApiClient juga mentoleransi kalau tetap ditulis dengan /api.)
#
# Pilih sesuai cara kamu menjalankan app:
#   - HP/tablet fisik (paling umum di sini):  http://localhost:5000
#     WAJIB diikuti perintah ini di komputer, dan diulang setiap kali adb
#     restart / device tercabut, karena mapping-nya hilang:
#         adb reverse tcp:5000 tcp:5000
#   - Emulator Android (AVD):                 http://10.0.2.2:5000
#     10.0.2.2 = alias host dari dalam emulator. JANGAN pakai localhost,
#     karena di emulator localhost menunjuk ke emulator itu sendiri.
#   - HP fisik via Wi-Fi (tanpa kabel):       http://<IP-LAN-komputer>:5000
#     Contoh: http://192.168.1.78:5000 — HP dan komputer harus satu jaringan,
#     dan port 5000 perlu diizinkan Windows Firewall.
API_BASE_URL=https://api.absensi-bumdesma.example.com
OFFICE_LATITUDE=-7.5188
OFFICE_LONGITUDE=111.8965
OFFICE_RADIUS_METERS=50

# --- Push notification (FCM) ---
# "true" -> app init Firebase + minta izin notif + daftarkan token ke backend.
# Pendaftaran token (POST /api/push/register) otomatis ke API_BASE_URL,
# membawa Authorization Bearer dari sesi login.
PUSH_NOTIFICATIONS_ENABLED=true
